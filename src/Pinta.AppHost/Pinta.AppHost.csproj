<Project Sdk="Aspire.AppHost.Sdk/13.6.3">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>pinta-apphost</UserSecretsId>
    <!-- `dotnet run` works without the Aspire CLI; the CLI bundle is optional. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MinIO" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pinta.Api\Pinta.Api.csproj" />
  </ItemGroup>
</Project>
